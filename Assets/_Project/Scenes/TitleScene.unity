  selectedColor: {r: 0.8509804, g: 0.7058824, b: 0.3529412, a: 1}
  normalColor: {r: 0.6392157, g: 0.6039216, b: 0.54901963, a: 1}
  gameSceneName: GameScene
  panelRoot: {fileID: 1156916585}
  panelTitle: {fileID: 138932772}
  panelBody: {fileID: 2099370544}
  panelFooter: {fileID: 1687318700}
  itemRows: {fileID: 370763416}
  itemTexts:
  - {fileID: 106494917}
  - {fileID: 1877390719}
  - {fileID: 867758600}
  - {fileID: 1865634845}
  itemData:
  - {fileID: 11400000, guid: 34923b93d70835f448fab45f6cd68c83, type: 2}
  - {fileID: 11400000, guid: 9fa720211fe4f2a409e7a6ff3f627d56, type: 2}
  - {fileID: 11400000, guid: 47a61241fbf52e241834e5ebcf2b92b5, type: 2}
  - {fileID: 11400000, guid: c76f2e658e8a2df47af0673dcc32cc29, type: 2}
  rulesPage1: "<color=#D9B45A>\uBAA9\uD45C</color>\uB294 \uB9E4 \uB77C\uC6B4\uB4DC \uC0C1\uB300 \uC794\uACE0\uB97C \uBA3C\uC800 0\uC73C\uB85C \uB9CC\uB4DC\uB294 \uAC83\uC774\uB2E4.\n\uC5B4\uB290 \uB77C\uC6B4\uB4DC\uB4E0 \uB0B4 \uC794\uACE0\uAC00 \uBA3C\uC800 0\uC774 \uB418\uBA74 <color=#D9B45A>\uD328\uBC30</color>\uD55C\uB2E4.\n<color=#D9B45A>\uB0B4 \uCC28\uB840</color>\uC5D0\uB294 \uC228\uACA8\uC9C4 \uCE94\uB4E4\uC744 \uB450\uACE0 \uB9E4\uC218\uB098 \uB9E4\uB3C4\uB97C \uACE0\uB978\uB2E4.\n<color=#A39A8C>\uD589\uB3D9<pos=22%>\uCE94\uB4E4<pos=44%>\uACB0\uACFC</color>\n\uB9E4\uC218<pos=22%><color=#6CC27F>\u25B2 \uC0C1\uC2B9</color><pos=44%>\uB808\uBC84\uB9AC\uC9C0 +1, <color=#D9B45A>\uD55C \uBC88 \uB354</color>\n\uB9E4\uC218<pos=22%><color=#E46A58>\u25BC \uD558\uB77D</color><pos=44%><color=#E46A58>\uB0B4 \uC794\uACE0 \u2212(1+\uB808\uBC84\uB9AC\uC9C0)</color>\n\uB9E4\uB3C4<pos=22%><color=#E46A58>\u25BC \uD558\uB77D</color><pos=44%><color=#E46A58>\uC0C1\uB300 \uC794\uACE0 \u2212(1+\uB808\uBC84\uB9AC\uC9C0)</color>\n\uB9E4\uB3C4<pos=22%><color=#6CC27F>\u25B2 \uC0C1\uC2B9</color><pos=44%>\uBCC0\uD654 \uC5C6\uC74C"
  rulesPage1Footer: "\"\uD55C \uBC88 \uB354\"\uAC00 \uC544\uB2C8\uBA74 \uCC28\uB840\uAC00 \uC0C1\uB300\uC5D0\uAC8C \uB118\uC5B4\uAC04\uB2E4."
  rulesLeverage: "<color=#D9B45A>\uB808\uBC84\uB9AC\uC9C0</color>\uB294 \uB2E4\uC74C \uD53C\uD574\uB97C \uD0A4\uC6B0\uB294 \uC22B\uC790\uB2E4.\n\uB450 \uC0AC\uB78C\uC774 \uD568\uAED8 \uC4F0\uACE0, 0\uC5D0\uC11C \uC2DC\uC791\uD55C\uB2E4.\n\uB9E4\uC218\uD55C \uCE94\uB4E4\uC774 \uC0C1\uC2B9\uD560 \uB54C\uB9C8\uB2E4 1\uC529 \uC624\uB978\uB2E4(\uCD5C\uB300 3).\n\uD558\uB77D\uC73C\uB85C \uBC1B\uB294 \uD53C\uD574\uB294 1 + \uB808\uBC84\uB9AC\uC9C0\uB2E4.\n\uD53C\uD574\uAC00 \uB098\uAC70\uB098 \uC0C8 \uB77C\uC6B4\uB4DC\uAC00 \uC2DC\uC791\uB418\uBA74 <color=#D9B45A>0\uC73C\uB85C \uCD08\uAE30\uD654</color>\uB41C\uB2E4.\n\uB9E4\uB3C4\uD55C \uCE94\uB4E4\uC774 \uC0C1\uC2B9\uD558\uBA74 \uB808\uBC84\uB9AC\uC9C0\uB294 \uADF8\uB300\uB85C\uB2E4.\n<color=#A39A8C>\uC608)</color> \uB808\uBC84\uB9AC\uC9C0 2\uC5D0\uC11C \uB9E4\uB3C4\uD55C \uCE94\uB4E4\uC774 \uD558\uB77D\uD558\uBA74\n     \uC0C1\uB300 \uC794\uACE0\uAC00 3 \uC904\uACE0, \uB808\uBC84\uB9AC\uC9C0\uB294 0\uC73C\uB85C \uCD08\uAE30\uD654\uB41C\uB2E4."
  rulesItems: "\uB77C\uC6B4\uB4DC \uC2DC\uC791\xB7\uB371 \uC7AC\uC7A5\uC804 \uB54C \uAC01\uC790 2\uAC1C\uC529 \uBC1B\uB294\uB2E4(\uCD5C\uB300 4\uAC1C).\n\uB0B4 \uCC28\uB840\uC5D0 1~4 \uD0A4\uB098 \uC544\uC774\uCF58\uC73C\uB85C \uACE0\uB974\uACE0 Space\uB85C \uC4F4\uB2E4."
  rulesControls: "<color=#D9B45A>Space \xB7 \uD074\uB9AD</color><pos=30%>\uBAA8\uB2C8\uD130\uB97C \uC5F4\uACE0, \uACE0\uB978 \uD589\uB3D9\uC744 \uC2E4\uD589\uD55C\uB2E4\n<color=#D9B45A>\u2190 \u2192 \xB7 A D</color><pos=30%>\uBAA8\uB2C8\uD130\uC5D0\uC11C \uB9E4\uC218\xB7\uB9E4\uB3C4\uB97C \uACE0\uB978\uB2E4\n<color=#D9B45A>1 ~ 4</color><pos=30%>\uC544\uC774\uD15C\uC744 \uD655\uC778\uD55C\uB2E4(Space\uB85C \uC0AC\uC6A9)\n<color=#D9B45A>Esc</color><pos=30%>\uCC3D\xB7\uC544\uC774\uD15C\uC744 \uB2EB\uAC70\uB098 \uC77C\uC2DC\uC815\uC9C0\uD55C\uB2E4"
  sfx: {fileID: 2143641331}
  clickClip: {fileID: 8300000, guid: aa56820f8d2dd214ba74c70a9a3f98e3, type: 3}
  credits: "Falling Knife\n\uB9CC\uB4E0 \uC0AC\uB78C   Kmg926\n\uC5D4\uC9C4   Unity 6.6 (URP 2D)\n\uAE00\uAF34   Galmuri11 \u2014 Lee Minseo (quiple)\n        SIL Open Font License 1.1\n        github.com/quiple/galmuri\n\uADF8\uB9BC\xB7\uD6A8\uACFC\uC74C   Claude(Anthropic)\uAC00 \uC791\uC131\uD55C \uCF54\uB4DC\uB85C \uC0DD\uC131\n        \uC120\uD0DD\xB7\uC218\uC815 \uC9C0\uC2DC: \uB9CC\uB4E0 \uC0AC\uB78C\n\uCF54\uB4DC \uB3C4\uC6C0   Claude(Anthropic)\n\uBC30\uACBD\uC74C\uC545   (\uC815\uD574\uC9C0\uBA74 \uCD94\uAC00)\n\uBE44\uC601\uB9AC \uD559\uAD50 \uACFC\uC81C"
