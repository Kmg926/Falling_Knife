  - {fileID: 21300000, guid: 27e07b7b009f47d40a596a3e8ca20c6b, type: 3}
  - {fileID: 21300000, guid: 533d28281ca42f0419a2447733ceedf2, type: 3}
  - {fileID: 21300000, guid: 263ee15f208b04d4fb637478bf92c09b, type: 3}
  - {fileID: 21300000, guid: 178d8c77fac6f494387f1fda8afd8522, type: 3}
  - {fileID: 21300000, guid: 0f21f7b881a000d489c2b134c91b8a5d, type: 3}
  - {fileID: 21300000, guid: 7561e371fa0c1104784ba326b5f1a876, type: 3}
  - {fileID: 21300000, guid: 6673acc3d86241c43b2d5d1c31532f58, type: 3}
  rulesItemsIntro: "\uB77C\uC6B4\uB4DC \uC2DC\uC791\xB7\uB371 \uC7AC\uC7A5\uC804 \uB54C 2\uAC1C\uC529 \uBC1B\uB294\uB2E4(\uCD5C\uB300 4\uAC1C).\n\uB0B4 \uD3F0\uC744 \uC5F4\uC5B4 \uACE0\uB974\uACE0 Space\uB85C \uC4F4\uB2E4."
  itemShort:
  - 
  - 
  - 
  - "\uC794\uACE0\xB7\uB808\uBC84\uB9AC\uC9C0\xB7\uC544\uC774\uD15C +1 \uB610\uB294 \uAF5D(25%\uC529)"
  - "\uC794\uACE0\uB97C 1 \uD68C\uBCF5\uD55C\uB2E4(\uC2DC\uC791 \uC794\uACE0\uAE4C\uC9C0)."
  - "\uBC18\uBC18 \uB3C4\uBC15: \uC794\uACE0 +2 \uB610\uB294 \u22121."
