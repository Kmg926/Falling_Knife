  - {fileID: 11400000, guid: 226ad1e96e40fe54f8ec7bcd1359035d, type: 2}
  - {fileID: 11400000, guid: 863f371f79ff6694bb4ef73dcd3fe245, type: 2}
  - {fileID: 11400000, guid: f9fa394f7e3f32a49b2f8570736c946b, type: 2}
  rulesScreen: {fileID: 1722424647}
  rulesScreenLegend: {fileID: 1154554474}
  rulesScreenNotes: {fileID: 1975106136}
  rulesScreenLegendText: "<color=#D9B45A>1</color> \uBAA8\uB2C8\uD130\n<color=#D9B45A>2</color> \uB808\uBC84\uB9AC\uC9C0\n<color=#D9B45A>3</color> \uB0B4 \uC794\uACE0\n<color=#D9B45A>4</color> \uAD11\uB300 \uC794\uACE0\n<color=#D9B45A>5</color> \uB0B4 \uD3F0\n<color=#D9B45A>6</color> \uAD11\uB300 \uD3F0\n<color=#D9B45A>7</color> \uB371"
  rulesScreenNotesText: "<color=#D9B45A>\uBAA9\uD45C</color>  \uC0C1\uB300 \uC794\uACE0\uB97C 0\uC73C\uB85C. \uB0B4 \uC794\uACE0\uAC00 0\uC774\uBA74 \uD328\uBC30\n<color=#D9B45A>Space\xB7\uD074\uB9AD</color> \uBAA8\uB2C8\uD130 \uC5F4\uAE30\xB7\uC2E4\uD589   <color=#D9B45A>\u2190 \u2192</color> \uB9E4\uC218\xB7\uB9E4\uB3C4\n<color=#D9B45A>\uD3F0\xB71~4</color> \uC544\uC774\uD15C   <color=#D9B45A>Esc</color> \uB2EB\uAE30\xB7\uC77C\uC2DC\uC815\uC9C0"
  rulesActions: "<line-height=88%><color=#D9B45A>\uB0B4 \uCC28\uB840</color>\uC5D0 \uC228\uACA8\uC9C4 \uCE94\uB4E4\uC744 \uB450\uACE0 \uB9E4\uC218\uB098 \uB9E4\uB3C4\uB97C \uACE0\uB978\uB2E4.\n<color=#A39A8C>\uD589\uB3D9<pos=20%>\uCE94\uB4E4<pos=40%>\uACB0\uACFC</color>\n\uB9E4\uC218<pos=20%><color=#6CC27F>\u25B2 \uC0C1\uC2B9</color><pos=40%>\uB808\uBC84\uB9AC\uC9C0 +1, <color=#D9B45A>\uD55C \uBC88 \uB354</color>\n\uB9E4\uC218<pos=20%><color=#E46A58>\u25BC \uD558\uB77D</color><pos=40%><color=#E46A58>\uB0B4\uAC00 \uB2E4\uC74C \uD53C\uD574\uB9CC\uD07C \uC783\uC74C</color>\n\uB9E4\uB3C4<pos=20%><color=#E46A58>\u25BC \uD558\uB77D</color><pos=40%><color=#E46A58>\uC0C1\uB300\uAC00 \uB2E4\uC74C \uD53C\uD574\uB9CC\uD07C \uC783\uC74C</color>\n\uB9E4\uB3C4<pos=20%><color=#6CC27F>\u25B2 \uC0C1\uC2B9</color><pos=40%>\uBCC0\uD654 \uC5C6\uC74C\n<color=#D9B45A>\uB808\uBC84\uB9AC\uC9C0</color>\uAC00 \uC313\uC77C\uC218\uB85D \uB2E4\uC74C \uD53C\uD574\uAC00 \uCEE4\uC9C4\uB2E4(\uCD5C\uB300 3).\n\uD53C\uD574\uAC00 \uB098\uAC70\uB098 \uB77C\uC6B4\uB4DC\uAC00 \uBC14\uB00C\uBA74 \uB808\uBC84\uB9AC\uC9C0\uB294 0.\n<color=#D9B45A>\uB371</color> \uAC1C\uC218\uB294 \uCC44\uC6B8 \uB54C\uB9CC \uBCF4\uC778\uB2E4. \uB0A8\uC740 \uC218\uB294 \uC9C1\uC811 \uC13C\uB2E4."
  rulesActionsFooter: "\"\uD55C \uBC88 \uB354\"\uAC00 \uC544\uB2C8\uBA74 \uCC28\uB840\uAC00 \uC0C1\uB300\uC5D0\uAC8C \uB118\uC5B4\uAC04\uB2E4."
  settings: {fileID: 1373693583}
  credits: "Falling Knife\n\uB9CC\uB4E0 \uC0AC\uB78C   Kmg926\n\uC5D4\uC9C4   Unity 6.6 (URP 2D)\n\uAE00\uAF34   Galmuri11 \u2014 Lee Minseo (quiple)\n        SIL Open Font License 1.1\n        github.com/quiple/galmuri\n\uADF8\uB9BC\xB7\uD6A8\uACFC\uC74C   Claude(Anthropic)\uAC00 \uC791\uC131\uD55C \uCF54\uB4DC\uB85C \uC0DD\uC131\n        \uC120\uD0DD\xB7\uC218\uC815 \uC9C0\uC2DC: \uB9CC\uB4E0 \uC0AC\uB78C\n\uCF54\uB4DC \uB3C4\uC6C0   Claude(Anthropic)\n\uBC30\uACBD\uC74C\uC545   xjj9 \u2014 prod. by cryalxt\n\uBE44\uC601\uB9AC \uD559\uAD50 \uACFC\uC81C"
  itemIcons:
  - {fileID: 1276016434}
  - {fileID: 1921259343}
  - {fileID: 81385643}
  - {fileID: 1077655711}
  - {fileID: 1652110015}
